# Modèle de .env pour la production sur VPS (voir DEPLOY.md).
# Sur le serveur : cp .env.production.example .env  puis remplacer chaque valeur "CHANGE-ME".
# Générer un secret aléatoire :  openssl rand -hex 32

# --- Domaine (doit déjà pointer vers l'IP du VPS dans le DNS) ---
DOMAIN=CHANGE-ME.example.com

DJANGO_SETTINGS_MODULE=config.settings.prod
SECRET_KEY=CHANGE-ME
DEBUG=False
ALLOWED_HOSTS=CHANGE-ME.example.com

# Le frontend et l'API sont servis sous le MÊME domaine (nginx route /api, /admin, /media... vers
# Django et le reste vers Next.js).
NEXT_PUBLIC_API_URL=https://CHANGE-ME.example.com
FRONTEND_URL=https://CHANGE-ME.example.com
CORS_ALLOWED_ORIGINS=https://CHANGE-ME.example.com

# --- Base de données (conteneur "db" de docker-compose) ---
USE_SQLITE=False
DB_ENGINE=django.db.backends.postgresql
DB_NAME=cstv
DB_USER=cstv
DB_PASSWORD=CHANGE-ME
DB_HOST=db
DB_PORT=5432

# --- Redis / Celery (conteneur "redis") ---
USE_LOCMEM_CACHE=False
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0
CELERY_TASK_ALWAYS_EAGER=False

# --- Emails (vérification de compte, mot de passe oublié) ---
# Sans serveur SMTP, laisser le backend console : les emails n'apparaissent que dans les logs.
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=no-reply@CHANGE-ME.example.com

ACCESS_TOKEN_LIFETIME_MIN=15
REFRESH_TOKEN_LIFETIME_DAYS=14

OMDB_API_KEY=
OMDB_BASE_URL=https://www.omdbapi.com/

FFMPEG_BINARY=ffmpeg
FFPROBE_BINARY=ffprobe
MAX_VIDEO_UPLOAD_SIZE_MB=2048

# --- Direct (OBS/Wirecast -> MediaMTX sur le port 1935 de ce serveur) ---
RTMP_INGEST_BASE_URL=rtmp://CHANGE-ME.example.com
RTMP_WEBHOOK_SECRET=CHANGE-ME

# --- Stockage des médias ---
# Vide = disque du VPS (volume Docker media_volume), servi par nginx. Suffisant pour démarrer.
# Renseigné = bucket S3-compatible (ex: Cloudflare R2) : utile quand le disque devient trop petit.
AWS_STORAGE_BUCKET_NAME=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_REGION_NAME=auto
AWS_S3_ENDPOINT_URL=
