DJANGO_SETTINGS_MODULE=config.settings.dev
SECRET_KEY=change-me
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

USE_SQLITE=True
DB_ENGINE=django.db.backends.postgresql
DB_NAME=cstv
DB_USER=cstv
DB_PASSWORD=cstv
DB_HOST=db
DB_PORT=5432

USE_LOCMEM_CACHE=True
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0
CELERY_TASK_ALWAYS_EAGER=True

EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=no-reply@cstv.local

FRONTEND_URL=http://localhost:3000
CORS_ALLOWED_ORIGINS=http://localhost:3000

# --- Frontend Next.js (docker-compose uniquement ; cf frontend/Dockerfile + docker/nginx/nginx.conf) ---
# URL publique par laquelle le navigateur joint l'API, une fois nginx en place devant tout le monde
# (frontend ET Django) sur le port 80. En prod, remplacer par le nom de domaine réel (https://...).
NEXT_PUBLIC_API_URL=http://localhost

ACCESS_TOKEN_LIFETIME_MIN=15
REFRESH_TOKEN_LIFETIME_DAYS=14

OMDB_API_KEY=
OMDB_BASE_URL=https://www.omdbapi.com/

FFMPEG_BINARY=ffmpeg
FFPROBE_BINARY=ffprobe
MAX_VIDEO_UPLOAD_SIZE_MB=2048

# --- Live (OBS/Wirecast -> MediaMTX, cf docker-compose.yml + docker/mediamtx/mediamtx.yml) ---
# En docker-compose, remplace "localhost" par le nom de domaine/IP publique du serveur : c'est
# l'adresse à laquelle OBS/Wirecast doivent se connecter (visible aussi depuis l'admin Django,
# sur chaque LiveStream).
RTMP_INGEST_BASE_URL=rtmp://localhost
HLS_PLAYBACK_BASE_URL=http://localhost/hls
RTMP_WEBHOOK_SECRET=change-me-rtmp-secret
# Dossier des enregistrements MediaMTX : ne pas définir hors Docker (repli automatique sur
# <projet>/live_recordings). docker-compose.yml le fixe à /recordings pour web et celery_worker.
# LIVE_RECORDINGS_ROOT=/recordings

# --- Stockage S3 (prod uniquement ; laisser vide pour rester sur le disque local) ---
AWS_STORAGE_BUCKET_NAME=
AWS_S3_REGION_NAME=eu-west-3
AWS_S3_CUSTOM_DOMAIN=
AWS_QUERYSTRING_AUTH=True
AWS_QUERYSTRING_EXPIRE=3600
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
